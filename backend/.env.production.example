# Copy this file to backend/.env in your production server.
# NEVER commit the real file or real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/videosnathan?sslmode=require"
JWT_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
PORT=4000
FRONTEND_URL="https://SEU-DOMINIO.example"
UPLOAD_DIR="./uploads"
PROCESSED_DIR="./processed"
FFMPEG_BIN=ffmpeg
WORKER_INTERVAL_MS=5000

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL="https://SEU-CDN.example"
CDN_BASE_URL="https://SEU-CDN.example"

# Live streaming
RTMP_INGEST_URL="rtmp://SEU-DOMINIO.example/live"

# Stripe Connect (leave blank until Stripe is configured)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
